# =============================================================================
# AgentForge Agents - Environment Configuration
# Copy to `.env` and adjust per environment. Never commit the real `.env`.
# =============================================================================

# --- Core ---------------------------------------------------------------------
AGENTFORGE_ENV=development
AGENTFORGE_DEBUG=false
AGENTFORGE_LOG_LEVEL=INFO

# --- Agent runtime ------------------------------------------------------------
AGENTFORGE_DEFAULT_AGENT=planner
AGENTFORGE_TASK_TIMEOUT_SECONDS=120
AGENTFORGE_TASK_MAX_RETRIES=3
AGENTFORGE_DEFAULT_MODEL=openai/gpt-4o-mini
AGENTFORGE_DEFAULT_TEMPERATURE=0.2
AGENTFORGE_MAX_ITERATIONS=10

# --- Event bus ----------------------------------------------------------------
AGENTFORGE_EVENT_BUS=local            # local | redis
AGENTFORGE_REDIS_URL=redis://localhost:6379/0
AGENTFORGE_REDIS_PREFIX=agentforge_agents

# --- Memory -------------------------------------------------------------------
AGENTFORGE_MEMORY_BACKEND=memory      # memory | redis
AGENTFORGE_MEMORY_TTL_SECONDS=86400
AGENTFORGE_MEMORY_DEFAULT_NAMESPACE=default
AGENTFORGE_MEMORY_SESSION_ISOLATION=true

# --- Embeddings ---------------------------------------------------------------
AGENTFORGE_EMBEDDING_PROVIDER=hash    # hash | openai | ollama
AGENTFORGE_EMBEDDING_MODEL=text-embedding-3-small

# --- LLM providers ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- External tool credentials ------------------------------------------------
GITHUB_TOKEN=
SLACK_BOT_TOKEN=
NOTION_API_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
SENDGRID_API_KEY=

# --- Docker execution ---------------------------------------------------------
AGENTFORGE_DOCKER_IMAGE=python:3.12-slim
AGENTFORGE_DOCKER_NETWORK=none
AGENTFORGE_DOCKER_TIMEOUT_SECONDS=120

# --- CLI / health server ------------------------------------------------------
AGENTFORGE_HOST=0.0.0.0
AGENTFORGE_PORT=8001